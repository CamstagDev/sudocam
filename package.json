{
  "name": "sudocam",
  "version": "0.4.0",
  "private": true,
  "description": "SudoCam: sudoku offline con jefes, logros y multi sudoku",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "escritorio": "vite build && electron .",
    "escritorio:dev": "electron . --dev",
    "instalador:windows": "vite build && electron-builder --win --publish never",
    "android:sync": "vite build && cap sync android",
    "android:apk": "npm run android:sync && node scripts/gradle.mjs assembleDebug",
    "version:nueva": "node scripts/nueva-version.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "main": "electron/main.js",
  "author": "CamstagDev",
  "build": {
    "appId": "com.camstagdev.sudocam",
    "productName": "SudoCam",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "SudoCam"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/share": "^8.0.3"
  }
}
